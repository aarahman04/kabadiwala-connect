{
  "name": "kabadiwala-connect",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --host --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "preview:phone": "vite preview --host --mode https",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.backend.json",
    "build:backend": "rolldown backend/src/index.ts --file backend/dist/server.mjs --platform node --format esm --external pg",
    "dev:backend": "npm run build:backend && node --env-file-if-exists=.env backend/dist/server.mjs",
    "db:sql": "rolldown backend/src/gen-sql.ts --file node_modules/.cache/kc/gen-sql.mjs --platform node --format esm && node node_modules/.cache/kc/gen-sql.mjs"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
